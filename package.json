{
  "name": "saudi-luxury-travel",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade luxury travel agency platform for Saudi Arabia (Hajj, Umrah, Domestic & International Tours, Hotels, Flights, Visa, Corporate Travel, Transportation).",
  "author": "Saudi Luxury Travel Engineering",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,css,yaml,yml}\"",
    "db:generate": "pnpm --filter @travel/db generate",
    "db:migrate": "pnpm --filter @travel/db migrate",
    "db:migrate:deploy": "pnpm --filter @travel/db migrate:deploy",
    "db:push": "pnpm --filter @travel/db push",
    "db:seed": "pnpm --filter @travel/db seed",
    "db:studio": "pnpm --filter @travel/db studio",
    "db:reset": "pnpm --filter @travel/db reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@travel/config": "workspace:*",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
