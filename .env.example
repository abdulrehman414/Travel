# =============================================================================
# Saudi Luxury Travel — Environment Variables (copy to .env and fill values)
# =============================================================================
# Every third-party integration is OPTIONAL for local development: when a key is
# absent the corresponding provider falls back to a safe local mock so the app
# still runs end-to-end. Provide real credentials to enable live behaviour.
# =============================================================================

# ------------------------------------------------------------------ Runtime ---
NODE_ENV=development

# ------------------------------------------------------------------ Database --
# Local dev matches docker-compose.yml. Change for staging/production.
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel_dev_password
POSTGRES_DB=travel
POSTGRES_PORT=5432
DATABASE_URL="postgresql://travel:travel_dev_password@localhost:5432/travel?schema=public"

# --------------------------------------------------------------------- Redis --
REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------------------- API (web) --
# Public base URL of the backend API consumed by the Next.js app (browser side).
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Server-to-server base URL (used inside Next.js server components / route handlers).
INTERNAL_API_URL="http://localhost:4000/api/v1"
# Public site URL (used for SEO canonical, sitemap, OpenGraph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# --------------------------------------------------------------- API (server) --
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS="http://localhost:3000"
# Public URL of the API itself (used for building absolute links in emails, webhooks).
API_PUBLIC_URL="http://localhost:4000"
# Public URL of the web frontend (used for redirects, email links).
WEB_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------- Auth/JWT --
# Generate strong secrets: `openssl rand -base64 48`
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Cookie configuration for refresh tokens.
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false
# Argon2/bcrypt cost (bcrypt salt rounds).
PASSWORD_SALT_ROUNDS=12

# ---------------------------------------------------------------- Cloudinary --
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="saudi-luxury-travel"

# -------------------------------------------------------------------- Stripe --
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_CURRENCY="sar"

# ------------------------------------------------------------------- HyperPay --
HYPERPAY_ENTITY_ID=""
HYPERPAY_ACCESS_TOKEN=""
HYPERPAY_BASE_URL="https://eu-test.oppwa.com"
HYPERPAY_CURRENCY="SAR"

# -------------------------------------------------------------------- PayTabs --
PAYTABS_PROFILE_ID=""
PAYTABS_SERVER_KEY=""
PAYTABS_BASE_URL="https://secure.paytabs.sa"
PAYTABS_CURRENCY="SAR"

# ------------------------------------------------------------------ HotelBeds --
HOTELBEDS_API_KEY=""
HOTELBEDS_SECRET=""
HOTELBEDS_BASE_URL="https://api.test.hotelbeds.com"

# ------------------------------------------------------------------- Amadeus --
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_BASE_URL="https://test.api.amadeus.com"

# --------------------------------------------------------------- Google Maps --
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# ---------------------------------------------------------------------- SMTP --
# Local dev uses Mailhog from docker-compose (host mailhog / port 1025).
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="Saudi Luxury Travel"
MAIL_FROM_ADDRESS="no-reply@saudiluxurytravel.com"

# ------------------------------------------------------------------ WhatsApp --
# WhatsApp Cloud API (Meta) for booking confirmations.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# ---------------------------------------------------------------- Rate limit --
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ------------------------------------------------------------------ Logging ---
LOG_LEVEL="debug"

# --------------------------------------------------------------- Admin seed ---
# Used by the database seed to create the first super-admin account.
SEED_ADMIN_EMAIL="admin@saudiluxurytravel.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Platform Administrator"
